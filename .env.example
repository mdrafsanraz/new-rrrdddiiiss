# Local (Docker Compose Postgres) or Railway Postgres
DATABASE_URL="postgresql://rdistro:rdistro@localhost:5432/rdistro?schema=public"

# Required — use a long random string in production
AUTH_SECRET="replace-with-a-long-random-secret"

# Public URL of this deployment (no trailing slash)
# Local: http://localhost:3000
# Railway: https://your-service.up.railway.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# LabelGrid — keep sandbox for now
LABELGRID_ENV="sandbox"
LABELGRID_API_TOKEN=""
# LABELGRID_BASE_URL="https://api-sandbox.stg.labelgrid.com/api/public"
# LABELGRID_ALLOW_PRODUCTION="true"  # never set until ready

# Stripe (optional until billing)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""

# Railway also sets automatically:
# PORT
# Set HOSTNAME=0.0.0.0 on Railway for the standalone server
