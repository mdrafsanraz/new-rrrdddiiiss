# Local (Docker Compose Postgres) or Railway Postgres
DATABASE_URL="postgresql://rdistro:rdistro@localhost:5432/rdistro?schema=public"

# Required — use a long random string in production
AUTH_SECRET="replace-with-a-long-random-secret"

# Comma-separated emails that get admin access (promoted on login)
# rafsan@rdistro.net is always included as a default admin
ADMIN_EMAILS="rafsan@rdistro.net"

# Resend — sends the forgot-password email. Without this set, reset links
# are logged to the server console instead of emailed (local dev fallback).
RESEND_API_KEY=""
EMAIL_FROM="RDISTRO <no-reply@rdistro.net>"

# Public URL of this deployment (no trailing slash)
# Local: http://localhost:3000
# Railway: https://your-service.up.railway.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# LabelGrid — keep sandbox for now
LABELGRID_ENV="sandbox"
LABELGRID_API_TOKEN=""
# Shared RDISTRO imprint on LabelGrid (do not create a label per signup)
# LABELGRID_LABEL_ID="12345"
# LABELGRID_BASE_URL="https://api-sandbox.stg.labelgrid.com/api/public"
# LABELGRID_ALLOW_PRODUCTION="true"  # never set until ready

# Stripe (optional until billing)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""

# Document storage (release documents — proof of rights, track licenses,
# etc.). Point these at an S3-compatible bucket, e.g. Railway's Bucket
# service — its "Connect" panel has the endpoint, access key, secret key,
# and bucket name to copy in here. Without these set, uploads fall back to
# local disk at UPLOADS_DIR (or ./uploads), which does NOT survive a
# Railway redeploy unless a volume is mounted there.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
# UPLOADS_DIR="/data/uploads"

# Railway also sets automatically:
# PORT
# Set HOSTNAME=0.0.0.0 on Railway for the standalone server
