generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanId {
  free
  starter
  pro
}

enum SubscriptionStatus {
  none
  active
  trialing
  past_due
  canceled
  incomplete
}

/**
 * Account role. Staff values gate /admin; `user` is the customer dashboard only.
 * Legacy rows with `admin` map to full ADMIN permissions until migrated to super_admin.
 */
enum UserRole {
  user
  super_admin
  admin
  reviewer
  support
  finance
}

enum DocumentReviewStatus {
  pending
  approved
  rejected
  replacement_requested
}

enum TakedownReason {
  user_requested
  compliance
  copyright
  fraud
  dsp_request
  administrative
}

enum TakedownStatus {
  requested
  submitted
  processing
  completed
  failed
}

enum InternalNoteEntity {
  user
  release
  document
  takedown
  support_ticket
}

enum AuditAction {
  release_approved
  release_changes_requested
  release_rejected
  release_held
  release_document_requested
  document_approved
  document_rejected
  document_replacement_requested
  user_suspended
  user_unsuspended
  user_terminated
  user_plan_changed
  impersonation_started
  impersonation_ended
  takedown_requested
  takedown_submitted
  labelgrid_sync
  staff_role_changed
  settings_changed
  payout_action
  note_added
  other
}

enum SupportTicketStatus {
  open
  in_progress
  answered
  closed
}

enum SupportTicketCategory {
  general
  release
  billing
  account
  technical
}

enum RoyaltyImportStatus {
  imported
  needs_review
  calculated
  published
  failed
}

enum RoyaltyPeriodStatus {
  draft
  imported
  matching
  needs_review
  calculated
  ready_to_publish
  published
  corrected
  superseded
}

enum RoyaltyMatchStatus {
  matched
  unmatched
  conflict
  manual_match
  unallocated
}

enum RoyaltyCalculationStatus {
  pending
  calculated
  excluded
}

enum RoyaltyStatementStatus {
  pending
  available
  paid
}

enum RoyaltyRuleScope {
  global
  plan
  user
}

enum RoyaltyAdjustmentType {
  fixed
  manual
  tax_withholding
  processing
  correction
  other
}

/**
 * Local release lifecycle (two review layers).
 * User-facing labels come from getUserFacingStatusLabel() — never expose raw values.
 * Legacy values (submitted, in_review, …) remain for existing rows; writers use the new names.
 */
enum ReleaseStatus {
  draft
  incomplete
  ready_to_submit
  pending_internal_review
  internal_changes_required
  internal_rejected
  internal_approved
  submitting_to_labelgrid
  labelgrid_in_review
  labelgrid_changes_required
  labelgrid_rejected
  labelgrid_approved
  delivering
  live
  takedown_pending
  taken_down
  sync_error
  on_hold
  // Legacy
  syncing
  submitted
  in_review
  changes_required
  rejected
  approved
  error
}

enum ReviewIssueSource {
  INTERNAL
  LABELGRID
}

enum ReleaseActivityType {
  created
  edited
  track_uploaded
  submitted_internal
  internal_changes_required
  internal_rejected
  internal_approved
  submitting_labelgrid
  labelgrid_in_review
  labelgrid_changes_required
  labelgrid_rejected
  labelgrid_approved
  document_uploaded
  resubmitted
  delivering
  live
  takedown_requested
  taken_down
  sync_error
  held
  document_requested
  document_reviewed
  qc_refreshed
  note
}

model User {
  id                   String             @id @default(cuid())
  email                String             @unique
  name                 String
  passwordHash         String
  role                 UserRole           @default(user)
  planId               PlanId             @default(free)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripeStatus         SubscriptionStatus @default(none)
  stripePriceId        String?
  /** Soft account flags for ops — never trust client alone. */
  suspended            Boolean            @default(false)
  suspendedAt          DateTime?
  suspendedReason      String?
  terminated           Boolean            @default(false)
  terminatedAt         DateTime?
  lastActiveAt         DateTime?
  /** Extra profile/contact data, collected from Settings — all optional. */
  phone                String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  region               String?
  postalCode           String?
  country              String?
  /** Non-sensitive payout preferences. Provider account details are never stored here. */
  payoutMethod         String?
  payoutEmail          String?
  payoutCurrency       String             @default("USD")
  payoutThreshold      Int                @default(50)
  payoutUpdatedAt      DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  artists          Artist[]
  releases         Release[]
  labels           Label[]
  reviewedReleases Release[] @relation("ReleaseReviewer")
  supportTickets   SupportTicket[]
  supportMessages  SupportMessage[]
  auditLogs        AuditLog[]            @relation("AuditActor")
  impersonationsAsAdmin ImpersonationSession[] @relation("ImpersonationAdmin")
  impersonationsAsTarget ImpersonationSession[] @relation("ImpersonationTarget")
  internalNotesAuthored InternalNote[]   @relation("InternalNoteAuthor")
  takedownsRequested TakedownRequest[]   @relation("TakedownRequester")
  writerMappings   WriterMapping[]
  publisherMappings PublisherMapping[]
  passwordResetTokens PasswordResetToken[]
  royaltyImportsUploaded RoyaltyImport[] @relation("RoyaltyImportUploader")
  royaltyPeriodsPublished RoyaltyPeriod[] @relation("RoyaltyPeriodPublisher")
  royaltyTransactions RoyaltyTransaction[]
  royaltyStatements UserRoyaltyStatement[]
  royaltyRules RoyaltyRule[]
  royaltyAdjustments RoyaltyAdjustment[] @relation("RoyaltyAdjustmentUser")
  royaltyAdjustmentsCreated RoyaltyAdjustment[] @relation("RoyaltyAdjustmentCreator")
  royaltyManualMatches RoyaltyTransaction[] @relation("RoyaltyManualMatcher")
}

/** Single-use, short-lived tokens for the forgot-password email flow. Only the hash is stored. */
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/** Optional local imprint; LabelGrid uses shared RDISTRO label — do not create LG labels per signup. */
model Label {
  id          String   @id @default(cuid())
  userId      String
  name        String
  labelgridId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  releases Release[]

  @@index([userId])
}

model Artist {
  id            String   @id @default(cuid())
  userId        String
  name          String
  fullName      String?
  email         String?
  location      String?
  bioShort      String?
  spotifyUrl    String?
  appleMusicUrl String?
  labelgridId   String?
  /** Locked after the artist is used on a submitted release — profile fields become read-only. */
  locked        Boolean  @default(false)
  lockedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  releases Release[]

  @@index([userId])
}

/**
 * Ownership mapping for LabelGrid writers (songwriters/composers).
 * The writer entity itself lives on LabelGrid (shared RDISTRO account);
 * this row only records which RDISTRO user created it, so one tenant's
 * writer list never appears in another tenant's picker. Names are cached
 * for search/display only — LabelGrid stays the source of truth.
 */
model WriterMapping {
  id          String   @id @default(cuid())
  userId      String
  labelgridId Int
  firstName   String
  lastName    String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, labelgridId])
  @@index([userId])
}

/**
 * Ownership mapping for LabelGrid publishers — same pattern as
 * WriterMapping: the entity lives on LabelGrid, this row records which
 * RDISTRO user created it (name cached for search/display only).
 */
model PublisherMapping {
  id          String   @id @default(cuid())
  userId      String
  labelgridId Int
  name        String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, labelgridId])
  @@index([userId])
}

model Release {
  id              String        @id @default(cuid())
  userId          String
  artistId        String?
  labelId         String?
  title           String
  catalogNumber   String
  upc             String?
  releaseDate     DateTime?
  /** LabelGrid ContentTypeEnum */
  contentType     String        @default("Single")
  /** LabelGrid AiUsageEnum for artwork */
  artworkAiUsage  String        @default("none")
  /** Local genre label until LabelGrid genre id is synced */
  primaryGenre    String?
  /** LabelGrid explicit: off | on | edited */
  explicit        String        @default("off")
  status          ReleaseStatus @default(draft)
  /**
   * Set once on first submit to RDISTRO internal review.
   * Free plan monthly quota uses this; resubmits must NOT overwrite.
   */
  submittedAt     DateTime?
  /** Pro plan: prioritize in RDISTRO moderation queue (not a LabelGrid API field). */
  priorityReview  Boolean       @default(false)
  /** Admin / internal review notes shown to the user. */
  reviewNotes     String?
  internalRejectionReason String?
  reviewedAt      DateTime?
  reviewedById    String?
  syncError       String?
  /** Last successful LabelGrid status sync (webhook or reconciliation). */
  lastSyncedAt    DateTime?
  /** Cached LabelGrid ReviewStatus (draft|to_review|require_changes|rejected|approved|…). */
  labelgridReviewStatus String?
  /** Cached overall delivery state from GET /releases/{id}/delivery-status. */
  deliveryState   String?
  /** Full delivery-status payload JSON (outlets, currently_live, …). */
  deliveryJson    String        @default("{}")
  /**
   * Cached Preflight QC (GET /releases/{id}/quality-report).
   * Optional LabelGrid add-on — may be unavailable (qcEnabled=false).
   */
  qcStatus        String?
  qcReportJson    String        @default("{}")
  qcFetchedAt     DateTime?
  qcStale         Boolean       @default(false)
  qcEnabled       Boolean       @default(true)
  qcChecksInProgress Boolean    @default(false)
  /** Internal hold — not a LabelGrid state. */
  holdReason      String?
  heldAt          DateTime?
  heldById        String?
  artworkUrl      String?
  territoriesJson String        @default("[]")
  storesJson      String        @default("[]")
  /** Extra ReleaseCreateData fields (JSON) — mix version, ©/℗, store URLs, etc. */
  metadataJson    String        @default("{}")
  /**
   * True after a final rejection (internal or LabelGrid) — no edit / resubmit.
   * Distinct from changes_required, which is editable and may re-enter review.
   */
  permanentlyLocked Boolean     @default(false)
  labelgridId     String?
  /** Mutex for the Step-5 submission flow — prevents two concurrent runs (double-click, two tabs) from both creating a LabelGrid release/track. Reclaimable after staleness timeout. */
  submissionLockedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("ReleaseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  artist     Artist? @relation(fields: [artistId], references: [id], onDelete: SetNull)
  label      Label?  @relation(fields: [labelId], references: [id], onDelete: SetNull)
  tracks     Track[]
  reviewIssues ReleaseReviewIssue[]
  activities   ReleaseActivity[]
  documents    ReleaseDocument[]
  webhookEvents ProviderWebhookEvent[]
  takedowns    TakedownRequest[]
  royaltyTransactions RoyaltyTransaction[]

  @@index([userId])
  @@index([artistId])
  @@index([userId, submittedAt])
  @@index([status])
  @@index([reviewedById])
  @@index([labelgridId])
  @@index([priorityReview, status])
  @@index([qcStatus])
  @@index([upc])
}

/** Review findings from RDISTRO admins or LabelGrid (synced). */
model ReleaseReviewIssue {
  id              String            @id @default(cuid())
  releaseId       String
  source          ReviewIssueSource
  providerIssueId String?
  code            String?
  category        String?
  title           String?
  message         String
  severity        String?
  isBlocking      Boolean           @default(true)
  requiresFeedback Boolean          @default(false)
  requiresDocument Boolean          @default(false)
  affectedTrackId String?
  providerTrackId Int?
  status          String            @default("open")
  resolved        Boolean           @default(false)
  resolvedAt      DateTime?
  evidenceJson    String            @default("[]")
  notesJson       String            @default("[]")
  rawJson         String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  release   Release            @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  documents ReleaseDocument[]

  @@index([releaseId])
  @@index([providerIssueId])
  @@index([resolved])
}

/** Append-only release timeline for support / compliance. */
model ReleaseActivity {
  id          String              @id @default(cuid())
  releaseId   String
  type        ReleaseActivityType
  title       String
  description String?
  actorUserId String?
  metadataJson String             @default("{}")
  createdAt   DateTime            @default(now())

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId, createdAt])
}

/**
 * User-uploaded evidence for review issues.
 * LabelGrid OpenAPI only documents note replies on issues (no file upload endpoint),
 * so files are stored locally; a note may be posted to LabelGrid when appropriate.
 */
model ReleaseDocument {
  id              String               @id @default(cuid())
  releaseId       String
  trackId         String?
  issueId         String?
  kind            String
  filename        String
  mimeType        String
  url             String
  uploadedById    String
  reviewStatus    DocumentReviewStatus @default(pending)
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?
  syncedNotePosted Boolean             @default(false)
  createdAt       DateTime             @default(now())

  release Release             @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  issue   ReleaseReviewIssue? @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([releaseId])
  @@index([issueId])
  @@index([reviewStatus])
}

/** Raw LabelGrid (or other) webhook payloads for audit + idempotent processing. */
model ProviderWebhookEvent {
  id                String   @id @default(cuid())
  provider          String   @default("labelgrid")
  eventType         String
  providerReleaseId String?
  releaseId         String?
  payloadJson       String
  processed         Boolean  @default(false)
  processedAt       DateTime?
  error             String?
  createdAt         DateTime @default(now())

  release Release? @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  @@index([provider, eventType])
  @@index([providerReleaseId])
  @@index([processed])
}

model Track {
  id          String   @id @default(cuid())
  userId      String
  releaseId   String
  title       String
  isrc        String?
  trackNumber Int      @default(1)
  durationMs  Int?
  audioUrl    String?
  /** Extra TrackCreateData fields (JSON). */
  metadataJson String  @default("{}")
  labelgridId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  release      Release            @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  contributors TrackContributor[]
  royaltyTransactions RoyaltyTransaction[]

  @@index([releaseId])
  @@index([userId])
  @@index([isrc])
}

model RoyaltyPeriod {
  id                   String              @id @default(cuid())
  period               String              @unique
  startDate            DateTime
  endDate              DateTime
  status               RoyaltyPeriodStatus @default(draft)
  importedAt           DateTime?
  calculatedAt         DateTime?
  publishedAt          DateTime?
  publishedById        String?
  unresolvedApprovedAt DateTime?
  unresolvedApprovedBy String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  publishedBy  User?                  @relation("RoyaltyPeriodPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  imports      RoyaltyImport[]
  transactions RoyaltyTransaction[]
  statements   UserRoyaltyStatement[]
  adjustments  RoyaltyAdjustment[]

  @@index([status])
  @@index([startDate])
}

model RoyaltyImport {
  id                     String              @id @default(cuid())
  royaltyPeriodId        String
  fileName               String
  source                 String              @default("labelgrid")
  checksum               String              @unique
  uploadedById           String
  importedAt             DateTime            @default(now())
  payPeriod              String
  rowCount               Int
  malformedRowCount      Int                 @default(0)
  totalSourceGross       Decimal             @db.Decimal(28, 12)
  totalSourceFees        Decimal             @db.Decimal(28, 12)
  totalSourceNet         Decimal             @db.Decimal(28, 12)
  status                 RoyaltyImportStatus @default(imported)
  errorSummary           Json?
  headerMap              Json
  createdAt              DateTime            @default(now())

  royaltyPeriod RoyaltyPeriod       @relation(fields: [royaltyPeriodId], references: [id], onDelete: Restrict)
  uploadedBy    User                @relation("RoyaltyImportUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  transactions  RoyaltyTransaction[]

  @@index([royaltyPeriodId])
  @@index([payPeriod])
  @@index([uploadedById])
}

model RoyaltyTransaction {
  id                          String                   @id @default(cuid())
  royaltyImportId             String
  royaltyPeriodId             String
  sourceRowNumber             Int
  sourceFingerprint           String
  payPeriod                   String
  retailer                    String?
  territory                   String?
  upc                         String?
  releaseTitle                String?
  isrc                        String?
  artistName                  String?
  trackTitle                  String?
  usageType                   String?
  quantity                    Decimal                  @db.Decimal(28, 8)
  sourceGrossUsd              Decimal                  @db.Decimal(28, 12)
  sourceTotalLabelGridFee     Decimal                  @db.Decimal(28, 12)
  sourceNetRevenueUsd         Decimal                  @db.Decimal(28, 12)
  rawSourceData               Json
  userId                      String?
  releaseId                   String?
  trackId                     String?
  labelgridReleaseId          String?
  labelgridTrackId            String?
  matchStatus                 RoyaltyMatchStatus       @default(unmatched)
  matchMethod                 String?
  matchConfidence             Decimal?                 @db.Decimal(5, 4)
  matchNotes                  String?
  manuallyMatchedById         String?
  manuallyMatchedAt           DateTime?
  originalMatchState          Json?
  calculationStatus           RoyaltyCalculationStatus @default(pending)
  royaltyRuleId               String?
  royaltyRuleVersion          Int?
  appliedCommissionRate       Decimal?                 @db.Decimal(9, 6)
  appliedRevenueShareRate     Decimal?                 @db.Decimal(9, 6)
  rdistroCommissionUsd        Decimal                  @default(0) @db.Decimal(28, 12)
  rdistroAdjustmentsUsd       Decimal                  @default(0) @db.Decimal(28, 12)
  rdistroOtherDeductionsUsd   Decimal                  @default(0) @db.Decimal(28, 12)
  userPayableUsd              Decimal                  @default(0) @db.Decimal(28, 12)
  calculationTimestamp        DateTime?
  calculationBreakdown        Json?
  userStatementId             String?
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt

  royaltyImport   RoyaltyImport         @relation(fields: [royaltyImportId], references: [id], onDelete: Restrict)
  royaltyPeriod   RoyaltyPeriod         @relation(fields: [royaltyPeriodId], references: [id], onDelete: Restrict)
  user            User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  release         Release?              @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  track           Track?                @relation(fields: [trackId], references: [id], onDelete: SetNull)
  manuallyMatchedBy User?               @relation("RoyaltyManualMatcher", fields: [manuallyMatchedById], references: [id], onDelete: SetNull)
  royaltyRule     RoyaltyRule?          @relation(fields: [royaltyRuleId], references: [id], onDelete: SetNull)
  userStatement   UserRoyaltyStatement? @relation(fields: [userStatementId], references: [id], onDelete: SetNull)
  adjustments     RoyaltyAdjustment[]

  @@unique([royaltyImportId, sourceRowNumber])
  @@index([sourceFingerprint])
  @@index([royaltyPeriodId, matchStatus])
  @@index([userId, royaltyPeriodId])
  @@index([releaseId])
  @@index([trackId])
  @@index([isrc])
  @@index([upc])
  @@index([retailer])
  @@index([territory])
  @@index([userStatementId])
}

model RoyaltyRule {
  id                   String           @id @default(cuid())
  name                 String
  scope                RoyaltyRuleScope
  userId               String?
  planId               PlanId?
  commissionRate       Decimal?         @db.Decimal(9, 6)
  revenueShareRate     Decimal?         @db.Decimal(9, 6)
  fixedAdjustment      Decimal          @default(0) @db.Decimal(28, 12)
  otherDeduction       Decimal          @default(0) @db.Decimal(28, 12)
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  version              Int
  active               Boolean          @default(true)
  createdById          String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user         User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions RoyaltyTransaction[]

  @@unique([name, version])
  @@index([scope, active, effectiveFrom])
  @@index([userId, active])
  @@index([planId, active])
}

model UserRoyaltyStatement {
  id                    String                 @id @default(cuid())
  userId                String
  royaltyPeriodId       String
  sourceNetTotal        Decimal                @db.Decimal(28, 12)
  totalDeductions       Decimal                @db.Decimal(28, 12)
  userPayableTotal      Decimal                @db.Decimal(28, 12)
  transactionCount      Int
  status                RoyaltyStatementStatus @default(pending)
  publishedAt           DateTime
  availableAt           DateTime?
  paidAt                DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  royaltyPeriod RoyaltyPeriod       @relation(fields: [royaltyPeriodId], references: [id], onDelete: Restrict)
  transactions RoyaltyTransaction[]

  @@unique([userId, royaltyPeriodId])
  @@index([userId, status])
  @@index([royaltyPeriodId])
}

model RoyaltyAdjustment {
  id              String                @id @default(cuid())
  userId          String
  royaltyPeriodId String
  transactionId   String?
  type            RoyaltyAdjustmentType
  amount          Decimal               @db.Decimal(28, 12)
  reason          String
  createdById     String
  createdAt       DateTime              @default(now())

  user          User                @relation("RoyaltyAdjustmentUser", fields: [userId], references: [id], onDelete: Restrict)
  royaltyPeriod RoyaltyPeriod       @relation(fields: [royaltyPeriodId], references: [id], onDelete: Restrict)
  transaction   RoyaltyTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdBy     User                @relation("RoyaltyAdjustmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([userId, royaltyPeriodId])
  @@index([transactionId])
  @@index([createdById])
}

model TrackContributor {
  id           String  @id @default(cuid())
  trackId      String
  name         String
  role         String
  sharePercent Float?
  labelgridId  String?

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId])
}

/** Internal RDISTRO support — users open tickets; admins reply from /admin/support. */
model SupportTicket {
  id        String                @id @default(cuid())
  userId    String
  subject   String
  category  SupportTicketCategory @default(general)
  status    SupportTicketStatus   @default(open)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId])
  @@index([status])
  @@index([updatedAt])
}

model SupportMessage {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String
  body       String
  /** true when the author is staff (admin reply). */
  isStaff    Boolean  @default(false)
  /** Staff-only note — never shown to the user. */
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([authorId])
}

/** Append-only staff audit trail — never editable/deletable via normal admin UI. */
model AuditLog {
  id           String      @id @default(cuid())
  actorUserId  String?
  action       AuditAction
  targetType   String
  targetId     String?
  summary      String
  metadataJson String      @default("{}")
  ip           String?
  createdAt    DateTime    @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([action])
}

model ImpersonationSession {
  id            String    @id @default(cuid())
  adminUserId   String
  targetUserId  String
  reason        String
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  ip            String?
  userAgent     String?

  admin  User @relation("ImpersonationAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)
  target User @relation("ImpersonationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, startedAt])
  @@index([targetUserId])
}

/** Staff-only notes — never exposed on the user dashboard. */
model InternalNote {
  id          String            @id @default(cuid())
  entityType  InternalNoteEntity
  entityId    String
  body        String
  authorId    String
  createdAt   DateTime          @default(now())

  author User @relation("InternalNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId, createdAt])
  @@index([authorId])
}

model TakedownRequest {
  id               String         @id @default(cuid())
  releaseId        String
  reason           TakedownReason
  status           TakedownStatus @default(requested)
  scope            String         @default("all")
  message          String?
  internalNotes    String?
  requestedById    String?
  submittedAt      DateTime?
  completedAt      DateTime?
  providerResponse String?
  error            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  release     Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  requestedBy User?   @relation("TakedownRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([releaseId])
  @@index([status])
  @@index([createdAt])
}
